FROM tencentos/tencentos3-minimal:3.3-v20241014 AS builder

# Define build argument for OpenSSH version
ARG OPENSSH_VERSION

RUN rm -f /etc/yum.repos.d/*.repo

ADD ./tencentos.repo /etc/yum.repos.d/tencentos.repo

RUN dnf -y install rpm-build dnf-plugins-core \
    && mkdir -p /root/rpmbuild/{BUILD,RPMS,SOURCES,SPECS,SRPMS}

COPY ./SOURCES/* /root/rpmbuild/SOURCES/
COPY ./SPECS/* /root/rpmbuild/SPECS/
COPY ./ipmitool-1.8.19.tar.gz /root/rpmbuild/SOURCES/

RUN dnf -y builddep /root/rpmbuild/SPECS/ipmitool.spec

RUN dnf -y install make

RUN rpmbuild -ba -v \
    /root/rpmbuild/SPECS/ipmitool.spec --nocheck